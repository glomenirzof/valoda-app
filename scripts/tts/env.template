# Template for the project-root .env file (copy this file to "<project>/.env" and fill in).
# .env is git-ignored — never commit real keys.

# --- Azure AI Speech (Text to Speech) ---
# Azure portal → your Speech resource → "Keys and Endpoint"
AZURE_SPEECH_KEY=
# Region of that resource, e.g. westeurope, northeurope, swedencentral
AZURE_SPEECH_REGION=

# --- Google Cloud Text-to-Speech (Chirp 3: HD) ---
# Option A: API key (APIs & Services → Credentials → Create credentials → API key,
#           restrict it to "Cloud Text-to-Speech API")
GOOGLE_TTS_API_KEY=
# Option B: service account JSON (absolute path). Used only if the API key is empty.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Piper (local, no key) ---
# Python inside the venv where piper-tts is installed.
# Default: %USERPROFILE%\.venvs\valoda-tts\Scripts\python.exe — must be an ASCII-only path.
PIPER_PYTHON=

# Azure Translator (второй переводчик для npm run content:check), бесплатный тариф F0
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=northeurope
