    "content:build": "python -I scripts/content/build_phrases.py lv",
    "content:export": "tsx scripts/content/export-review.ts lv",
    "content:import": "tsx scripts/content/import-review.ts"
  },
  "type": "module",
  "dependencies": {
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true
