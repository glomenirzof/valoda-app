{
  "name": "valoda-app",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "tezaurs:check": "python -I scripts/tezaurs/check_forms.py",
    "tts:voicetest": "tsx scripts/tts/voice-test.ts",
